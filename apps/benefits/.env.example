# Never commit live credentials. Leave unset until the service is configured.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
# Start disabled until official Bizinfo API usage has been approved.
COLLECTOR_SOURCE=all
BIZINFO_API_KEY=
# Government24 benefits (data.go.kr / odcloud, decoded API key)
GOV24_API_KEY=
GOV24_MAX_PAGES=5
GOV24_PER_PAGE=100
GOV24_DETAIL_LIMIT=20
# 0 disables expensive per-notice AI; enable only after reviewing cost/time.
OLLAMA_MAX_RECORDS=0
SOURCE_FEED_URL=
INGEST_URL=
INGEST_TOKEN=

# Enter the ACTUAL approved daily quota shown for each issued key; public defaults are NOT approval proof.
GOV24_APPROVED_DAILY_CALLS=10000
BIZINFO_APPROVED_DAILY_CALLS=1000
# Set to 80, 81, ..., 90. The collector reserves calls BEFORE each HTTP attempt.
API_BUDGET_PERCENT=90
# Enable full catalog scans only after quotas verified; never enable blindly.
GOV24_DAILY_FULL_CATALOG=YES
CONFIRM_GOV24_BULK_QUOTA=YES

# Prioritize enrichment of D1 records still missing official details.
GOV24_BACKFILL_ENABLED=YES
BIZINFO_MAX_PAGES=50
