---
permalink: /sitemap.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment -%}
    정적 서비스·신뢰 페이지는 내용이 바뀔 때 아래 static_lastmod를 함께 갱신한다.
    블로그 글은 각 글의 last_modified_at / date를 그대로 쓴다.
  {%- endcomment -%}
  {%- assign static_lastmod = '2026-11-27T19:40:00+09:00' -%}
  <url><loc>{{ site.url }}{{ site.baseurl }}/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/blog/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/editorial-policy/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/about/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/about/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/privacy/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/privacy/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/tags/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/tags/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/contact/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/contact/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/nutrition-calculator/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/nutrition-calculator/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <!-- 서브앱 — 2026-11-27 색인 허용 -->
  <url><loc>{{ site.url }}{{ site.baseurl }}/map/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/map/restaurants/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/map/stays/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/map/overseas/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/calendar/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/first/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/mileage/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/route/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/new/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/guide/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/card/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/guides/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  {% for pair in site.data.calculator_guides %}
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/{{ pair[0] }}/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  {% endfor %}
  <url><loc>{{ site.url }}{{ site.baseurl }}/hotel/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/hotel/points-stay/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/hotel/weekend-reward/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/macro/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/macro/fear-greed/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/macro/rates-inflation/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/300-seconds/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/scalping-king/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/rhythm-classic/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/hormuz/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/government-support/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/business-funding/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/privacy/</loc><lastmod>{{ static_lastmod }}</lastmod></url>
  {% for page in site.pages %}
  {% if page.url contains '/category/' and page.noindex != true %}
  <url>
    <loc>{{ page.url | absolute_url | uri_escape | xml_escape }}</loc>
    <lastmod>{{ static_lastmod }}</lastmod>
  </url>
  {% endif %}
  {% endfor %}
  {% for post in site.posts %}
  {% unless post.noindex %}
  <url>
    <loc>{{ post.url | absolute_url | uri_escape | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
