permalink: /sitemap.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/blog/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/editorial-policy/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/privacy/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/privacy/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/tags/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/tags/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/contact/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/contact/</loc>
  </url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/nutrition-calculator/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/en/nutrition-calculator/</loc></url>
  <!-- 서브앱 — 2026-11-27 색인 허용 -->
  <url><loc>{{ site.url }}{{ site.baseurl }}/map/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/calendar/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/first/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/mileage/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/route/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/new/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/air/guide/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/guides/</loc></url>
  {% for pair in site.data.calculator_guides %}
  <url><loc>{{ site.url }}{{ site.baseurl }}/cal/{{ pair[0] }}/</loc></url>
  {% endfor %}
  <url><loc>{{ site.url }}{{ site.baseurl }}/hotel/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/300-seconds/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/scalping-king/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/rhythm-classic/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/games/hormuz/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/benefits/privacy/</loc></url>
  {% for page in site.pages %}
  {% if page.url contains '/category/' and page.noindex != true %}
  <url>
    <loc>{{ page.url | absolute_url | uri_escape | xml_escape }}</loc>
  </url>
  {% endif %}
  {% endfor %}
  {% for post in site.posts %}
  {% unless post.noindex %}
  <url>
    <loc>{{ post.url | absolute_url | uri_escape | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
