---
permalink: /sitemap.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/privacy/</loc>
  </url>
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/privacy/</loc>
  </url>
  {% for page in site.pages %}
  {% if page.url contains '/category/' %}
  <url>
    <loc>{{ page.url | absolute_url | uri_escape | xml_escape }}</loc>
  </url>
  {% endif %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
